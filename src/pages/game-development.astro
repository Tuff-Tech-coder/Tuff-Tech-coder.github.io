---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
---

<BaseLayout title="Game development contracting | Tuff Tech" description="Gameplay prototype and systems development for indie game teams, including prototype repair and technical tools.">
  <header class="page-hero">
    <div class="shell">
      <p class="eyebrow">Game development</p>
      <h1>Playable proof, scoped systems, and technical momentum.</h1>
      <p class="lede">Tuff Tech provides gameplay prototype and systems development for indie teams that need a mechanic tested, a contained system implemented, or a stalled prototype made reviewable again.</p>
      <p class="placeholder"><strong>PLACEHOLDER:</strong> Add primary engine, supported versions, languages, and current contracting availability.</p>
    </div>
  </header>

  <section class="section">
    <div class="shell split">
      <h2>Available contributions</h2>
      <div class="service-grid">
        <article class="card"><p class="eyebrow">01</p><h3>Rapid gameplay prototypes</h3><p>Small playable experiments built to answer a design or feasibility question before a team commits further.</p></article>
        <article class="card"><p class="eyebrow">02</p><h3>Gameplay systems</h3><p>Self-contained mechanics and supporting code with explicit integration points and acceptance criteria.</p></article>
        <article class="card"><p class="eyebrow">03</p><h3>Prototype repair</h3><p>Technical triage, stabilization, completion planning, and focused implementation for promising but stalled builds.</p></article>
        <article class="card"><p class="eyebrow">04</p><h3>Technical & editor tools</h3><p>Utilities that reduce repetitive content work, improve iteration, or make a system easier for the team to tune.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading"><p class="eyebrow">Evidence to add</p><h2>Gameplay reel and playable work</h2><p class="lede">This section is intentionally incomplete until real media, build links, and contribution notes are supplied.</p></div>
      <div class="media-placeholder"><p><strong>PLACEHOLDER — GAMEPLAY REEL</strong><br />Add an embedded reel or a poster image linked to a hosted reel.</p></div>
      <div class="service-grid" style="margin-top: 1rem;">
        <article class="card"><h3>Playable build 01</h3><p class="placeholder"><strong>PLACEHOLDER:</strong> Build URL, engine, target platform, controls, exact contribution, project status, and whether this is independent, collaborative, or client work.</p></article>
        <article class="card"><h3>Playable build 02</h3><p class="placeholder"><strong>PLACEHOLDER:</strong> Build URL, engine, target platform, controls, exact contribution, project status, and whether this is independent, collaborative, or client work.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell split">
      <h2>Technical breakdown template</h2>
      <div class="stack-lg">
        <p>For each piece, document what the team can actually evaluate—not just a title and screenshot.</p>
        <ul class="check-list">
          <li><strong>Engine:</strong> <span class="placeholder">PLACEHOLDER — engine and version</span></li>
          <li><strong>Languages:</strong> <span class="placeholder">PLACEHOLDER — languages and relevant tools</span></li>
          <li><strong>Contribution:</strong> <span class="placeholder">PLACEHOLDER — exact systems and assets you owned</span></li>
          <li><strong>Technical breakdown:</strong> <span class="placeholder">PLACEHOLDER — architecture, constraints, tradeoffs, and known limitations</span></li>
          <li><strong>Status:</strong> Label independent prototypes, collaborations, and paid work accurately.</li>
        </ul>
      </div>
    </div>
  </section>

  <CTA title="Need a mechanic made testable?" body="Send the engine, current project state, desired outcome, and what must remain outside scope. Tuff Tech will respond with fit and a practical first milestone." />
</BaseLayout>
