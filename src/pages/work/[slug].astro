---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTA from '../../components/CTA.astro';
import { caseStudies, type CaseStudy } from '../../data/site';

export function getStaticPaths() {
  return caseStudies.map((study) => ({ params: { slug: study.slug }, props: { study } }));
}

interface Props { study: CaseStudy }
const { study } = Astro.props;

const sections = [
  ['problem', 'Problem'],
  ['constraints', 'Constraints'],
  ['responsibility', 'Responsibility'],
  ['solution', 'Solution'],
  ['demonstration', 'Demonstration'],
  ['reliability', 'Reliability'],
  ['deliverables', 'Deliverables'],
  ['outcome', 'Verifiable outcome'],
];
---

<BaseLayout title={`${study.title} case study | Daniel Alvarado`} description={study.summary}>
  <header class="page-hero">
    <div class="shell">
      <p class="eyebrow">Case study · {study.eyebrow}</p>
      <h1>{study.title}</h1>
      <p class="lede">{study.summary}</p>
      <div class="action-row"><a class="button button-secondary" href={study.repository}>View source repository <span aria-hidden="true">↗</span></a></div>
    </div>
  </header>

  <article class="section">
    <div class="shell case-study">
      <nav class="case-index" aria-label="Case study sections">
        <ol>{sections.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
      </nav>
      <div class="case-content">
        <section class="case-section" id="problem"><p class="eyebrow">01</p><h2>Problem</h2><p>{study.problem}</p></section>
        <section class="case-section" id="constraints"><p class="eyebrow">02</p><h2>Constraints</h2><ul>{study.constraints.map((item) => <li>{item}</li>)}</ul></section>
        <section class="case-section" id="responsibility"><p class="eyebrow">03</p><h2>Responsibility</h2><p>{study.responsibility}</p></section>
        <section class="case-section" id="solution"><p class="eyebrow">04</p><h2>Solution</h2><ul>{study.solution.map((item) => <li>{item}</li>)}</ul></section>
        <section class="case-section" id="demonstration"><p class="eyebrow">05</p><h2>Demonstration</h2><p>{study.demonstration}</p></section>
        <section class="case-section" id="reliability"><p class="eyebrow">06</p><h2>Reliability</h2><ul>{study.reliability.map((item) => <li>{item}</li>)}</ul></section>
        <section class="case-section" id="deliverables"><p class="eyebrow">07</p><h2>Deliverables</h2><ul>{study.deliverables.map((item) => <li>{item}</li>)}</ul></section>
        <section class="case-section" id="outcome"><p class="eyebrow">08</p><h2>Verifiable outcome</h2><p class="outcome">{study.outcome}</p><a class="text-link" href={study.repository}>Inspect the repository <span aria-hidden="true">↗</span></a></section>
      </div>
    </div>
  </article>

  <CTA />
</BaseLayout>
