---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import CTA from '../components/CTA.astro';
import { caseStudies } from '../data/site';
---

<BaseLayout title="Daniel Alvarado | Technical implementation partner" description="Technical implementation for agencies and indie game teams: automation, data workflows, gameplay prototypes, and self-contained systems.">
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Technical implementation partner</p>
        <h1>Practical systems, built to <span>hand off cleanly.</span></h1>
        <p class="lede">I help agencies clear technical delivery bottlenecks and indie game teams turn scoped ideas into working prototypes and systems.</p>
        <div class="action-row">
          <a class="button" href="/contact/">Discuss a project <span aria-hidden="true">→</span></a>
          <a class="button button-secondary" href="/work/">View selected work</a>
        </div>
      </div>
      <p class="hero-note">Available for scoped subcontracting, prototype work, overflow delivery, and maintainable follow-on support.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="paths-heading">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">Two clear paths</p>
        <h2 id="paths-heading">Choose the workstream that fits.</h2>
        <p class="lede">The engagement stays focused: a defined problem, practical milestones, reviewable source, and a documented handoff.</p>
      </div>
      <div class="path-grid">
        <article class="card path-card">
          <p class="eyebrow">For agencies & consultants</p>
          <h3>Agency automation</h3>
          <p>White-label Python, spreadsheet, reporting, API, and permitted web-data automation delivered behind your client relationship.</p>
          <a class="text-link" href="/automation/">Explore agency automation <span aria-hidden="true">→</span></a>
        </article>
        <article class="card path-card">
          <p class="eyebrow">For indie game teams</p>
          <h3>Game development</h3>
          <p>Rapid gameplay prototypes, self-contained systems, prototype repair, and editor or technical tools with a controlled scope.</p>
          <a class="text-link" href="/game-development/">Explore game development <span aria-hidden="true">→</span></a>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="work-heading">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">Selected work</p>
        <h2 id="work-heading">Small systems with clear operational jobs.</h2>
        <p class="lede">These are public, inspectable projects—not an automatically generated repository feed and not presented as paid client engagements.</p>
      </div>
      <div class="work-grid">
        {caseStudies.map((study) => <CaseStudyCard study={study} />)}
      </div>
    </div>
  </section>

  <section class="section band" aria-labelledby="working-heading">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">Built for handoff</p>
        <h2 id="working-heading">Useful after the first demo.</h2>
      </div>
      <div class="principles">
        <div class="principle"><h3>Scoped</h3><p>Milestones, acceptance criteria, assumptions, and exclusions are made visible early.</p></div>
        <div class="principle"><h3>Reviewable</h3><p>Source is delivered through Git with documentation and a clear run path.</p></div>
        <div class="principle"><h3>Maintainable</h3><p>Handoffs can include a recorded walkthrough, issue notes, and optional maintenance.</p></div>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>
