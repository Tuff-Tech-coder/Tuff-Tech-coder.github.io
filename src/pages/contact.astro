---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="Contact Daniel Alvarado" description="Contact Daniel Alvarado about agency automation subcontracting, gameplay prototypes, systems development, or technical overflow work.">
  <header class="page-hero">
    <div class="shell">
      <p class="eyebrow">Contact</p>
      <h1>Start with the problem, not a polished brief.</h1>
      <p class="lede">Send what you know, what is uncertain, and what a successful handoff would let your team do next.</p>
    </div>
  </header>

  <section class="section">
    <div class="shell contact-grid">
      <div class="stack-lg">
        <h2>A useful first message</h2>
        <ul class="check-list">
          <li>Whether this is agency automation or game-development work.</li>
          <li>The current input, system, prototype, or repository.</li>
          <li>The outcome you need and who will review it.</li>
          <li>Important deadlines, platform limits, permissions, or NDA requirements.</li>
          <li>Any budget range or milestone constraint already decided.</li>
        </ul>
        <p class="placeholder"><strong>PLACEHOLDER:</strong> Add timezone, usual response window, preferred meeting method, and contracting region if you want these public.</p>
      </div>
      <aside class="contact-options" aria-label="Contact methods">
        <div class="contact-option"><span>Best for project inquiries</span><a class="text-link" href={`mailto:${site.email}`}>{site.email}</a></div>
        <div class="contact-option"><span>Professional profile</span><a class="text-link" href={site.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a></div>
        <div class="contact-option"><span>Public source work</span><a class="text-link" href={site.github}>GitHub <span aria-hidden="true">↗</span></a></div>
        <p>No form, tracking script, or database is used on this site.</p>
      </aside>
    </div>
  </section>
</BaseLayout>
