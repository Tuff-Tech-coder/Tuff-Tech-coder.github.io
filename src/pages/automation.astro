---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
---

<BaseLayout title="Agency automation subcontracting | Tuff Tech" description="White-label Python, spreadsheet, reporting, API, and permitted web-data automation for agencies and consultants.">
  <header class="page-hero">
    <div class="shell">
      <p class="eyebrow">Agency automation</p>
      <h1>Technical overflow, without competing for your client.</h1>
      <p class="lede">White-label implementation for agencies and consultants that need Python, spreadsheet, reporting, API, or permitted web-data automation delivered under a clear subcontracting boundary.</p>
      <div class="action-row"><a class="button" href="/contact/">Discuss an overflow need <span aria-hidden="true">→</span></a></div>
    </div>
  </header>

  <section class="section">
    <div class="shell split">
      <h2>Implementation lanes</h2>
      <div class="service-grid">
        <article class="card"><p class="eyebrow">01</p><h3>Python workflows</h3><p>File processing, scheduled jobs, transformations, internal utilities, and repeatable operational scripts.</p></article>
        <article class="card"><p class="eyebrow">02</p><h3>Spreadsheet systems</h3><p>Excel, CSV, and Google Sheets cleanup, consolidation, generation, validation, and reporting.</p></article>
        <article class="card"><p class="eyebrow">03</p><h3>Reporting & APIs</h3><p>Data retrieval, calculations, formatted outputs, integrations, and documented delivery paths.</p></article>
        <article class="card"><p class="eyebrow">04</p><h3>Permitted web data</h3><p>Collection from sources and methods that the engagement is authorized to use, with rate, terms, and reliability constraints made explicit.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell split">
      <h2>A subcontractor-friendly boundary</h2>
      <ul class="check-list">
        <li>White-label delivery that supports your agency’s client relationship.</li>
        <li>NDA-friendly work and need-to-know access to client material.</li>
        <li>No solicitation of your agency’s clients.</li>
        <li>Fixed milestones with acceptance criteria and defined change handling.</li>
        <li>Documentation and a recorded handoff for the delivered system.</li>
        <li>Git-based source delivery with reviewable history.</li>
        <li>Maintenance availability after the handoff, scoped separately.</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="shell trial">
      <div class="stack">
        <p class="eyebrow">Low-risk starting point</p>
        <h2>Technical Overflow Trial</h2>
        <p class="lede">Start with one bounded task that is useful on its own: a small automation, a troublesome data transformation, a report proof of concept, or a technical discovery spike.</p>
      </div>
      <aside class="stack">
        <h3>Trial shape</h3>
        <ul class="check-list">
          <li>One defined outcome</li>
          <li>One fixed milestone</li>
          <li>Source and setup notes</li>
          <li>Recorded walkthrough</li>
          <li>Go / no-go decision afterward</li>
        </ul>
        <p class="placeholder"><strong>PLACEHOLDER:</strong> Add preferred trial budget range and typical turnaround before publishing a commercial offer.</p>
      </aside>
    </div>
  </section>

  <CTA title="Have a delivery bottleneck?" body="Share the task, current inputs, constraints, and target handoff. Tuff Tech will determine whether it fits a trial or a larger milestone plan." />
</BaseLayout>
